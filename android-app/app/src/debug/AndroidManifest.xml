<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto de DEBUG (mescla só em builds debug). Adiciona um ícone SEPARADO
  no launcher — "Atmosfera Teste" — que abre o painel de debug (DebugActivity),
  onde dá pra escolher cenário / arte do fundo / estilo dos efeitos e ver a
  prévia ao vivo, sem depender da loja/compra.

  A DebugActivity em si (exported=false) segue declarada no manifesto principal;
  aqui só criamos um atalho de launcher via activity-alias.

  `usesCleartextTraffic` existe só aqui: o acervo de teste é servido pelo
  servidor do tester em `http://10.0.2.2:8123/dist/` (HTTP puro). Em release o
  acervo vem do bucket por HTTPS e a permissão NÃO existe — este manifesto não
  mescla no build de release.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:usesCleartextTraffic="true" tools:ignore="UnusedAttribute">
        <activity-alias
            android:name=".debug.DebugLauncher"
            android:targetActivity=".debug.DebugActivity"
            android:exported="true"
            android:label="Atmosfera Teste"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
