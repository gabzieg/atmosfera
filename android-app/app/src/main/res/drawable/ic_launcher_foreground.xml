<?xml version="1.0" encoding="utf-8"?>
<!--
  Camada de FRENTE do adaptive icon — deliberadamente vazia.

  A arte do ícone é a própria cena da cabana e mora na camada de FUNDO
  (`mipmap-*/ic_launcher_bg.png`), que é onde o Android espera cenário que
  sangra até a borda. A camada de frente existe porque `<adaptive-icon>` pede as
  duas, e ela é a que os launchers deslocam em animação de parallax — arte de
  cena ali ficaria descolada do fundo ao animar.

  Antes daqui havia uma montanha com sol, geométrica e genérica, com o sol fora
  da zona segura: a máscara do launcher cortava ele e o resultado no aparelho era
  um pedaço de amarelo grudado na borda.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:fillColor="#00000000"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"/>
</vector>
