# Copie este arquivo para "keystore.properties" (mesma pasta, android-app/) e
# preencha com os dados reais. keystore.properties NUNCA é commitado — já
# coberto pelo .gitignore. Sem ele, o build de release simplesmente não assina
# (assembleDebug e a CI não são afetados).
#
# Gerar a keystore de produção (uma vez só, guarde em local seguro — perder
# esse arquivo impede publicar updates do mesmo app na Play Store):
#   keytool -genkey -v -keystore atmosfera-release.jks \
#     -alias atmosfera -keyalg RSA -keysize 2048 -validity 10000

storeFile=../atmosfera-release.jks
storePassword=
keyAlias=atmosfera
keyPassword=
